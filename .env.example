APP_NAME="AMAN BOOKING"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (MySQL / MariaDB on cPanel)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aman_booking
DB_USERNAME=root
DB_PASSWORD=

# Session & Cache (Database or File driver recommended for cPanel)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

# Queue Driver (database queue recommended for cPanel without Redis)
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=aman_booking_cache_

# Mail Configuration (SMTP / cPanel Webmail)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.yourdomain.com
MAIL_PORT=465
MAIL_USERNAME=noreply@yourdomain.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Payment Gateway (Fase 3 - Midtrans / Xendit)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# WhatsApp Notification Gateway (Fase 4 - Fonnte / Wablas)
WHATSAPP_GATEWAY_TOKEN=
WHATSAPP_GATEWAY_ENDPOINT=

VITE_APP_NAME="${APP_NAME}"
