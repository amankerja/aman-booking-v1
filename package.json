{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "start": "node ./node_modules/concurrently/dist/bin/concurrently.js -k -c \"blue.bold,green.bold,magenta.bold\" -n \"LARAVEL,VITE,QUEUE\" \"php artisan serve\" \"npm run dev\" \"php artisan queue:listen\"",
        "dev": "node ./node_modules/vite/bin/vite.js",
        "build": "node ./node_modules/vite/bin/vite.js build",
        "lint": "node ./node_modules/eslint/bin/eslint.js resources/js",
        "lint:fix": "node ./node_modules/eslint/bin/eslint.js resources/js --fix",
        "format": "node ./node_modules/prettier/bin/prettier.cjs --check \"resources/**/*.{ts,tsx,css}\"",
        "format:fix": "node ./node_modules/prettier/bin/prettier.cjs --write \"resources/**/*.{ts,tsx,css}\"",
        "test": "node ./node_modules/vitest/vitest.mjs run",
        "test:watch": "node ./node_modules/vitest/vitest.mjs",
        "test:e2e": "node ./node_modules/@playwright/test/cli.js test"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@playwright/test": "^1.63.0",
        "@tailwindcss/vite": "^4.0.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^26.6.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^4.7.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "eslint": "^9.39.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.13.0",
        "jsdom": "^29.1.1",
        "laravel-vite-plugin": "^2.0.0",
        "prettier": "^3.9.9",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.0",
        "vite": "^7.0.7",
        "vitest": "^5.0.3"
    },
    "dependencies": {
        "@inertiajs/react": "^3.8.0",
        "@xyflow/react": "^12.12.0",
        "clsx": "^2.1.1",
        "lucide-react": "^1.51.0",
        "qrcode.react": "^4.2.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "tailwind-merge": "^3.7.0"
    }
}
